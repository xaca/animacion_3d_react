rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Jeopardy rooms: rooms/{code}, where code is 4 capital letters (see roomService.ts).
    // There is no login, so anyone with the code can play in the room.
    match /rooms/{code} {
      allow read, delete: if true;
      allow create: if code.matches('^[A-Z]{4}$') && isRoom(request.resource.data) && request.resource.data.code == code;
      allow update: if isRoom(request.resource.data) && request.resource.data.code == code;
    }

    // Question bank, uploaded by scripts/seed-questions.ts with the Admin SDK
    // (which bypasses these rules). The app only reads it.
    match /questions/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }

    function isRoom(data) {
      return data.keys().hasOnly(['code', 'version', 'status', 'teams', 'board', 'activeTile', 'answers', 'players',
          'topic', 'timerSeconds', 'maxTeamSize', 'startSeconds', 'readSeconds', 'startsAt', 'readEndsAt', 'optionsAt',
          'questionEndsAt', 'revealed'])
        && data.status in ['setup', 'lobby', 'board', 'question', 'end'];
    }
  }
}
